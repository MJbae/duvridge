{
  "name": "duvridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": { "node": ">=22 <23", "npm": ">=10 <11" },
  "workspaces": ["apps/*", "apps/autobio-audiobook/web", "packages/*"],
  "scripts": {
    "test": "npm run test:repo && npm run test --workspaces --if-present",
    "test:repo": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:rules": "firebase emulators:exec --config firebase.json --only firestore --project demo-family-library \"node --test packages/reader-core/firebase/tests/firestore.rules.test.mjs\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:novels": "npm run dev --workspace @duvridge/autobio-bae",
    "dev:audiobooks": "npm run dev --workspace @duvridge/autobio-audiobook",
    "build:toldlife": "python3 scripts/build-toldlife.py",
    "affected": "node scripts/affected.mjs",
    "verify:deploy": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": { "@playwright/test": "1.63.0", "firebase-tools": "15.31.0" }
}
