{
  "version": 1,
  "globalPaths": ["package.json", "package-lock.json", ".npmrc", ".nvmrc", "services.json", "scripts/", "tests/", ".github/workflows/"],
  "ignoredPaths": ["README.md", "docs/"],
  "deployGroups": {
    "company": {
      "project": "duvridge", "origin": "https://www.duvridge.com", "output": ".deploy/company",
      "assembleCommand": [], "smokePaths": ["/", "/ko/", "/ja/", "/zh-Hans/", "/zh-Hant/", "/guidebook/", "/guidebook/privacy/"]
    },
    "toldlife": {
      "project": "toldlife", "origin": "https://toldlife.duvridge.com", "output": ".deploy/toldlife",
      "assembleCommand": ["python3", "scripts/build-toldlife.py", "--skip-build"],
      "smokePaths": ["/", "/novels/", "/novels/read/ep01", "/audiobooks/", "/audiobooks/read/ep01"],
      "audioPaths": ["/audiobooks/record/prolog.mp3"]
    }
  },
  "services": [
    {
      "id": "company", "path": "apps/company", "workspace": "@duvridge/company", "deployGroup": "company",
      "checks": ["test", "build"], "artifactPath": ".deploy/company", "siteBase": "/"
    },
    {
      "id": "toldlife", "path": "apps/toldlife", "workspace": "@duvridge/toldlife", "deployGroup": "toldlife",
      "watchedPaths": ["apps/company/assets/brand/", "apps/company/assets/social/"],
      "checks": ["test"], "artifactPath": "", "siteBase": "/"
    },
    {
      "id": "autobio-bae", "path": "apps/autobio-bae", "workspace": "@duvridge/autobio-bae", "deployGroup": "toldlife",
      "checks": ["test", "build", "test:sharing", "typecheck"],
      "artifactPath": "apps/autobio-bae/site/.vitepress/dist", "siteBase": "/novels/", "requiredFiles": ["read/ep01.html"]
    },
    {
      "id": "autobio-audiobook", "path": "apps/autobio-audiobook/web", "workspace": "@duvridge/autobio-audiobook", "deployGroup": "toldlife",
      "checks": ["test", "build", "test:sharing", "typecheck"],
      "artifactPath": "apps/autobio-audiobook/web/site/.vitepress/dist", "siteBase": "/audiobooks/", "requiredFiles": ["read/ep01.html", "record/prolog.mp3"]
    }
  ]
}
