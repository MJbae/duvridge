{
  "version": 1,
  "workspaceScope": "@duvridge",
  "globalPaths": [
    "package.json",
    "package-lock.json",
    ".npmrc",
    ".nvmrc",
    "service-registry.json",
    "scripts/",
    "tests/",
    ".github/workflows/"
  ],
  "ignoredPaths": [
    "README.md",
    "docs/"
  ],
  "deployGroups": {
    "company": {
      "project": "duvridge",
      "origin": "https://www.duvridge.com",
      "output": ".deploy/company",
      "assembleCommand": [],
      "smokePaths": [
        "/",
        "/ko/",
        "/ja/",
        "/zh-Hans/",
        "/zh-Hant/",
        "/guidebook/",
        "/guidebook/privacy/"
      ]
    },
    "toldlife": {
      "project": "toldlife",
      "origin": "https://toldlife.duvridge.com",
      "output": ".deploy/toldlife",
      "assembleCommand": [
        "python3",
        "scripts/assemble-toldlife-pages.py",
        "--skip-build"
      ],
      "smokePaths": [
        "/",
        "/novels/bae-byunghee/",
        "/novels/bae-byunghee/ep01",
        "/audiobooks/bae-byunghee/",
        "/audiobooks/bae-byunghee/prolog",
        "/videos/bae-byunghee/",
        "/videos/bae-byunghee/prolog"
      ],
      "audioPaths": [
        "/audiobooks/works/bae-byunghee/record/prolog.mp3",
        "/videos/works/bae-byunghee/record/prolog.mp3"
      ]
    }
  },
  "services": [
    {
      "id": "company-site",
      "path": "apps/company-site",
      "workspace": "@duvridge/company-site",
      "deployGroup": "company",
      "checks": [
        "test",
        "build"
      ],
      "artifactPath": ".deploy/company",
      "siteBase": "/"
    },
    {
      "id": "toldlife-portal",
      "path": "apps/toldlife-portal",
      "workspace": "@duvridge/toldlife-portal",
      "deployGroup": "toldlife",
      "watchedPaths": [
        "apps/company-site/assets/brand/",
        "apps/company-site/assets/social/"
      ],
      "checks": [
        "test"
      ],
      "artifactPath": "",
      "siteBase": "/",
      "bookCatalog": true
    },
    {
      "id": "toldlife-novels",
      "path": "apps/toldlife-novels",
      "workspace": "@duvridge/toldlife-novels",
      "deployGroup": "toldlife",
      "checks": [
        "test",
        "build",
        "test:sharing",
        "typecheck"
      ],
      "artifactPath": "apps/toldlife-novels/site/.vitepress/dist",
      "siteBase": "/novels/",
      "requiredFiles": [
        "bae-byunghee/index.html",
        "bae-byunghee/ep01.html"
      ],
      "bookCatalog": true
    },
    {
      "id": "toldlife-audiobooks",
      "path": "apps/toldlife-audiobooks",
      "workspace": "@duvridge/toldlife-audiobooks",
      "deployGroup": "toldlife",
      "checks": [
        "test",
        "build",
        "test:sharing",
        "typecheck"
      ],
      "artifactPath": "apps/toldlife-audiobooks/site/.vitepress/dist",
      "siteBase": "/audiobooks/",
      "requiredFiles": [
        "bae-byunghee/index.html",
        "bae-byunghee/ep01.html",
        "works/bae-byunghee/record/prolog.mp3"
      ],
      "bookCatalog": true
    },
    {
      "id": "toldlife-videos",
      "path": "apps/toldlife-videos",
      "workspace": "@duvridge/toldlife-videos",
      "deployGroup": "toldlife",
      "bookCatalog": true,
      "watchedPaths": [
        "apps/toldlife-audiobooks/content/narration/",
        "apps/toldlife-audiobooks/site/public/record/"
      ],
      "checks": [
        "test",
        "build",
        "test:sharing",
        "typecheck"
      ],
      "artifactPath": "apps/toldlife-videos/site/.vitepress/dist",
      "siteBase": "/videos/",
      "requiredFiles": [
        "bae-byunghee/index.html",
        "bae-byunghee/prolog.html",
        "works/bae-byunghee/record/prolog.mp3"
      ]
    }
  ],
  "bookCatalog": {
    "path": "content/books"
  }
}
