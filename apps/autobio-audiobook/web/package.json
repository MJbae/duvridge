{
  "name": "@duvridge/autobio-audiobook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "narration:sync": "node scripts/sync-narration.mjs",
    "predev": "npm run prepare:content",
    "dev": "vitepress dev site --host 127.0.0.1",
    "prebuild": "npm run prepare:content",
    "build": "vitepress build site",
    "preview": "vitepress preview site --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "pretest": "npm run prepare:content",
    "test": "node --test tests/content.test.mjs tests/narration.test.mjs tests/player.test.mjs",
    "test:sharing": "node --test tests/sharing.test.mjs",
    "assets:share": "node scripts/generate-share-assets.mjs",
    "assets:cover": "node scripts/generate-home-cover.mjs",
    "assets:episodes": "node scripts/generate-episode-assets.mjs",
    "test:rules": "firebase emulators:exec --config ../../../firebase.json --only firestore --project demo-family-library \"node --test tests/firestore.rules.test.mjs\"",
    "test:e2e": "playwright test",
    "test:reactions": "firebase emulators:exec --config ../../../firebase.json --only auth,firestore --project demo-family-library \"playwright test --config playwright.reactions.config.ts\"",
    "pretypecheck": "npm run prepare:content",
    "prenarration:sync": "npm run prepare:content"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "vue": "3.5.43",
    "@duvridge/reader-core": "*",
    "@duvridge/memoir-content": "*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "gray-matter": "^4.0.3",
    "typescript": "^5.9.3",
    "vitepress": "1.6.4",
    "vue-tsc": "3.3.11"
  }
}
