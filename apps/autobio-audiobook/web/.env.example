# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱의 공개 설정값.
# 서비스 계정 키나 Admin SDK 비밀키는 여기에 넣지 마세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# GitHub Pages: /bae-memoir/ ; ToldLife: /novels/ 또는 /audiobooks/ ; 로컬 루트: /
SITE_BASE=/bae-memoir/
# ToldLife 배포 시 https://toldlife.duvridge.com
SITE_ORIGIN=https://mjbae.github.io

# 로컬 테스트용. 실제 배포에서는 설정하지 마세요.
VITE_USE_FIREBASE_EMULATORS=false
